rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // O app usa autenticação anônima em segundo plano.
    // Não existe tela de login para o funcionário.
    match /inovaFitSystem/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /inovaFitDaily/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Todo o restante fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
